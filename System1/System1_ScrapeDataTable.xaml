  <Sequence sap2010:Annotation.AnnotationText="Reads the Work Items table of the page currently shown in the ACME browser into out_DataTable (columns WIID, Description, Type, Status, Date; cells mapped by header name).&#xA;Pagination is handled by the REFramework transaction loop." DisplayName="System1 Scrape Data Table" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="TableHtml" />
      <Variable x:TypeArguments="s:String[]" Name="Headers" />
      <Variable x:TypeArguments="scg:List(s:String[])" Name="RowCells" />
    </Sequence.Variables>
    <uix:NApplicationCard AttachMode="ByInstance" CloseMode="Never" DisplayName="Use Browser Chrome: ACME System 1 (attach)" HealingAgentBehavior="Job" sap2010:WorkflowViewState.IdRef="NApplicationCard_1" InteractionMode="DebuggerApi" OpenMode="Never" ScopeGuid="dfd8ab27-88e7-4458-a228-27d5a15740eb" Version="V2">
      <uix:NApplicationCard.Body>
        <ActivityAction x:TypeArguments="x:Object">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Object" Name="WSSessionData" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Do" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <uix:NGetAttributeGeneric x:TypeArguments="x:String" Attribute="outerHtml" sap2010:Annotation.AnnotationText="Reads the Work Items table HTML. Used instead of Extract Table Data so no Studio extraction wizard is needed; parsed into out_DataTable below." DisplayName="Get Attribute (Work Items table outerHtml)" HealingAgentBehavior="SameAsCard" Result="[TableHtml]" sap2010:WorkflowViewState.IdRef="NGetAttributeGeneric`1_1" Version="V5">
              <uix:NGetAttributeGeneric.Target>
                <uix:TargetAnchorable ContentHash="7NUJbetByUSKAP907PoCxw" DesignTimeRectangle="336, 538, 1248, 526" ElementVisibilityArgument="Interactive" FullSelectorArgument="&lt;webctrl aaname='Actions WIID Description Type Status Date' parentclass='*panel-default*' tag='TABLE' /&gt;" Guid="df763194-2ac9-44fc-a0d6-a2328307a4f7" InformativeScreenshot="119b6d56184caa1121503c410915faa0.jpg" Reference="DIuyqXOjKk6448nZPJQ7wA/ZpgY9D6TNkC59dK5e2eZbg" ScopeSelectorArgument="&lt;html app='chrome.exe' title='*ACME System*' url='https://acme-test.uipath.com/work-items*' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
              </uix:NGetAttributeGeneric.Target>
