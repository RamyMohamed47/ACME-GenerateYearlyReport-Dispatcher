    <Assign DisplayName="Assign out_DataTable (empty)" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="sd:DataTable">[out_DataTable]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sd:DataTable">[New DataTable("WorkItems")]</InArgument>
      </Assign.Value>
    </Assign>
    <InvokeMethod DisplayName="Add columns WIID, Description, Type, Status, Date" MethodName="AddRange" sap2010:WorkflowViewState.IdRef="InvokeMethod_1">
      <InvokeMethod.TargetObject>
        <InArgument x:TypeArguments="sd:DataColumnCollection">[out_DataTable.Columns]</InArgument>
      </InvokeMethod.TargetObject>
      <InArgument x:TypeArguments="sd:DataColumn[]">[{New DataColumn("WIID", GetType(String)), New DataColumn("Description", GetType(String)), New DataColumn("Type", GetType(String)), New DataColumn("Status", GetType(String)), New DataColumn("Date", GetType(String))}]</InArgument>
    </InvokeMethod>
    <Assign DisplayName="Assign Headers" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="s:String[]">[Headers]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="s:String[]">[Regex.Matches(TableHtml, "&lt;th[^&gt;]*&gt;(.*?)&lt;/th&gt;", RegexOptions.Singleline Or RegexOptions.IgnoreCase).Cast(Of Match).Select(Function(c) WebUtility.HtmlDecode(Regex.Replace(c.Groups(1).Value, "&lt;[^&gt;]+&gt;", "")).Trim).ToArray]</InArgument>
      </Assign.Value>
    </Assign>
    <If Condition="[Not {&quot;WIID&quot;, &quot;Description&quot;, &quot;Type&quot;, &quot;Status&quot;, &quot;Date&quot;}.All(Function(h) Headers.Contains(h))]" DisplayName="If expected columns are missing" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
          <Throw DisplayName="Throw System Exception (Unexpected table layout)" sap2010:WorkflowViewState.IdRef="Throw_1">
            <Throw.Exception>
              <InArgument x:TypeArguments="s:Exception">[New Exception("Work Items table headers changed. Found: " + String.Join(", ", Headers))]</InArgument>
            </Throw.Exception>
          </Throw>
        </Sequence>
      </If.Then>
    </If>
    <Assign DisplayName="Assign RowCells" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(s:String[])">[RowCells]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(s:String[])">[Regex.Matches(TableHtml, "&lt;tr[^&gt;]*&gt;(.*?)&lt;/tr&gt;", RegexOptions.Singleline Or RegexOptions.IgnoreCase).Cast(Of Match).Select(Function(r) Regex.Matches(r.Groups(1).Value, "&lt;td[^&gt;]*&gt;(.*?)&lt;/td&gt;", RegexOptions.Singleline Or RegexOptions.IgnoreCase).Cast(Of Match).Select(Function(c) WebUtility.HtmlDecode(Regex.Replace(c.Groups(1).Value, "&lt;[^&gt;]+&gt;", "")).Trim).ToArray).Where(Function(cells) cells.Length = Headers.Length).ToList]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:ForEach x:TypeArguments="s:String[]" DisplayName="For Each table row" sap2010:WorkflowViewState.IdRef="ForEach`1_1">
      <ui:ForEach.Values>
        <InArgument x:TypeArguments="sc:IEnumerable">[RowCells]</InArgument>
      </ui:ForEach.Values>
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="s:String[]">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="s:String[]" Name="cells" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_4">
            <uic:AddDataRow DisplayName="Add Data Row (work item)" sap2010:WorkflowViewState.IdRef="AddDataRow_1">
              <uic:AddDataRow.DataTable>
                <InOutArgument x:TypeArguments="sd:DataTable">[out_DataTable]</InOutArgument>
              </uic:AddDataRow.DataTable>
              <uic:AddDataRow.ArrayRow>
                <InArgument x:TypeArguments="s:Object[]">[New Object() {cells(Array.IndexOf(Headers, "WIID")), cells(Array.IndexOf(Headers, "Description")), cells(Array.IndexOf(Headers, "Type")), cells(Array.IndexOf(Headers, "Status")), cells(Array.IndexOf(Headers, "Date"))}]</InArgument>
              </uic:AddDataRow.ArrayRow>
            </uic:AddDataRow>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:LogMessage DisplayName="Log Message (Rows extracted)" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;Extracted &quot; + out_DataTable.Rows.Count.ToString + &quot; work item(s) from the current page.&quot;]" />
  </Sequence>
</Activity>