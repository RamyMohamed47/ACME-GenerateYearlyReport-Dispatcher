  <Sequence sap2010:Annotation.AnnotationText="Keeps the rows whose Type equals in_Type and Status equals in_Status (trimmed, exact match)." DisplayName="System1 Filter WI Datatable" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:IEnumerable(sd:DataRow)" Name="FilteredRows" />
    </Sequence.Variables>
    <If Condition="[Not (in_Datatable.Columns.Contains(&quot;Type&quot;) AndAlso in_Datatable.Columns.Contains(&quot;Status&quot;) AndAlso in_Datatable.Columns.Contains(&quot;WIID&quot;))]" DisplayName="If required columns are missing" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Throw DisplayName="Throw System Exception (Unexpected table layout)" sap2010:WorkflowViewState.IdRef="Throw_1">
            <Throw.Exception>
              <InArgument x:TypeArguments="s:Exception">[New Exception("Scraped Work Items table must have columns WIID, Type and Status. Found: " + String.Join(", ", in_Datatable.Columns.Cast(Of DataColumn).Select(Function(c) c.ColumnName)))]</InArgument>
            </Throw.Exception>
          </Throw>
        </Sequence>
      </If.Then>
    </If>
    <Assign DisplayName="Assign FilteredRows" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:IEnumerable(sd:DataRow)">[FilteredRows]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:IEnumerable(sd:DataRow)">[in_Datatable.AsEnumerable().Where(Function(r) r("Type").ToString.Trim = in_Type AndAlso r("Status").ToString.Trim = in_Status)]</InArgument>
      </Assign.Value>
    </Assign>
    <If Condition="[FilteredRows.Any()]" DisplayName="If any row matches" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
          <Assign DisplayName="Assign out_FilteredDatatable (matches)" sap2010:WorkflowViewState.IdRef="Assign_2">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataTable">[out_FilteredDatatable]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataTable">[FilteredRows.CopyToDataTable()]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else" sap2010:WorkflowViewState.IdRef="Sequence_4">
          <Assign DisplayName="Assign out_FilteredDatatable (empty)" sap2010:WorkflowViewState.IdRef="Assign_3">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataTable">[out_FilteredDatatable]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataTable">[in_Datatable.Clone()]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Else>
    </If>
    <ui:LogMessage DisplayName="Log Message (Filter result)" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[out_FilteredDatatable.Rows.Count.ToString + &quot; of &quot; + in_Datatable.Rows.Count.ToString + &quot; row(s) match Type '&quot; + in_Type + &quot;' and Status '&quot; + in_Status + &quot;'.&quot;]" />
  </Sequence>
</Activity>
